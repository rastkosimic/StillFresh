# ============================================================
# StillFresh local development — copy to .env and fill in values
#   cp .env.example .env   (or copy manually on Windows)
# This file is safe to commit. NEVER commit .env (it is gitignored).
#
# Before first `docker-compose up`, generate DB init SQL from templates:
#   powershell -File ./scripts/generate-init-sql.ps1
#   # or: bash ./scripts/generate-init-sql.sh
# See SECRETS.md for the full catalog and rotation notes.
# ============================================================

# PostgreSQL database passwords (must match generated init-*.sql)
POSTGRES_PASSWORD_USER=change-me
POSTGRES_PASSWORD_VENDOR=change-me
POSTGRES_PASSWORD_AUTH=change-me
POSTGRES_PASSWORD_OFFERS=change-me
POSTGRES_PASSWORD_ORDERS=change-me
POSTGRES_PASSWORD_PAYMENTS=change-me
POSTGRES_PASSWORD_NOTIFICATION=change-me

# Shared JWT signing secret — MUST be the same in every service that validates JWTs
JWT_SECRET=change-me-use-a-long-random-string

# Shared gateway trust secret — must match gateway.internal.secret in every service
# Dev-only default below; use a strong unique value in any shared/staging/prod environment
GATEWAY_INTERNAL_SECRET=stillfresh-gw-dev-secret-change-in-prod

# Shared secret for service-to-service internal endpoints (/api/auth/**, /vendors/internal,
# /orders/internal). Dev-only default; production uses .env.prod.
INTERNAL_SERVICE_SECRET=stillfresh-internal-dev-secret-change-in-prod

# One-time token for POST /admin/create-initial-admin. Empty disables the endpoint.
# Set it to create the first SUPER_ADMIN locally, then clear it.
ADMIN_BOOTSTRAP_TOKEN=

# Google OAuth2 (authorization-service)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun (authorization-service, user-service, vendor-service, notification-service)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Optional: reservation / transactional emails (notification-service)
# NOTIFICATION_EMAIL_ENABLED=true

# Stripe (payment-service) — use a test key locally; never commit live keys
STRIPE_API_KEY=

# Google Maps (vendor-service)
GOOGLE_MAPS_API_KEY=

# Firebase Admin SDK JSON on the host (mounted into notification-service)
# Example (Windows): C:/Users/you/secrets/firebase-adminsdk.json
FIREBASE_CREDENTIALS_HOST_PATH=

# Platform bank account (bank-transfer payment instructions)
PLATFORM_IBAN=REPLACE_WITH_YOUR_IBAN
PLATFORM_BANK_NAME=REPLACE_WITH_YOUR_BANK_NAME
PLATFORM_ACCOUNT_HOLDER=REPLACE_WITH_YOUR_COMPANY_NAME
BANK_TRANSFER_EXPIRY_HOURS=24

# Payout scheduler and rail (stub | sepa-xml | cmiplus)
PAYOUT_SCHEDULE_CRON=0 0 2 * * *
PAYOUT_DEFAULT_CURRENCY=RSD
PAYOUT_MAX_BATCH_AMOUNT_CENTS=0
PAYOUT_RAIL=stub
PAYOUT_AUTO_ENABLED=true
PAYOUT_AUTO_APPROVE=true
PAYOUT_AUTO_EXECUTE=true
PAYOUT_SEPA_XML_OUTPUT_DIR=/tmp/stillfresh-payouts

# CMIplus (set CMIPLUS_STUB_MODE=false once RBI marketplace credentials are ready)
CMIPLUS_STUB_MODE=true
CMIPLUS_BASE_URL=
CMIPLUS_CLIENT_ID=
CMIPLUS_CLIENT_SECRET=
CMIPLUS_KEYSTORE_PATH=
CMIPLUS_KEYSTORE_PASSWORD=

# Payment provider: "stripe" (default) or "allsecure"
PAYMENT_PROVIDER=allsecure

# AllSecure Exchange sandbox credentials (from AllSecure merchant portal / simulator docs)
ALLSECURE_BASE_URL=https://asxgw.paymentsandbox.cloud
ALLSECURE_API_KEY=genericmerchant-simulator-1
ALLSECURE_SHARED_SECRET=your-sandbox-shared-secret
ALLSECURE_USERNAME=genericmerchant-api-1
# Escape literal $ as $$ when using docker-compose .env interpolation
ALLSECURE_PASSWORD=your-sandbox-api-password
ALLSECURE_INTEGRATION_KEY=sJBHPYLTFPNXjDYrQocG-1
ALLSECURE_CURRENCY=RSD

# Public URL for AllSecure return + callback (must reach api-gateway :8080 from the internet).
# Local dev: run `ngrok http 8080`, then run `scripts/update-allsecure-public-url.ps1`
# or set manually to the https Forwarding URL (no trailing slash).
ALLSECURE_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev
