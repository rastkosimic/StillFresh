# ============================================================
# StillFresh PRODUCTION environment — copy to .env.prod on the server and fill in.
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# This file is safe to commit. NEVER commit .env.prod (it is gitignored).
#
# Every value below is REQUIRED unless marked optional. The prod Spring profiles declare
# secrets without fallbacks, so a missing variable fails service startup rather than
# silently using a development default. ProdConfigGuard additionally rejects secrets that
# are present but weak or left at a published default value.
#
# Generate each secret independently, e.g.:
#   openssl rand -base64 48
# ============================================================

# Activates the prod Spring profile in every service.
SPRING_PROFILES_ACTIVE=prod

# --- Public addressing -------------------------------------------------------
# Public HTTPS origin of the API gateway, as reached from the internet through the
# reverse proxy. No trailing slash. Used for OAuth2 redirects, password-reset links,
# Stripe Connect return URLs and AllSecure callbacks.
APP_PUBLIC_BASE_URL=https://api.example.com

# Hostnames for the Caddy reverse proxy (see deploy/Caddyfile).
PUBLIC_DOMAIN=api.example.com
ADMIN_PUBLIC_DOMAIN=admin.example.com
MARKETING_PUBLIC_DOMAIN=www.example.com

# Browser origins allowed to call the API. Comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://www.example.com

# Public origin of the admin SPA; baked into the admin-web image at build time.
ADMIN_WEB_API_BASE_URL=https://api.example.com

# --- Database passwords ------------------------------------------------------
# Must match the generated init-*.sql used when the volumes were first created.
# The legacy FreshStill011* passwords are recoverable from git history: do not reuse them.
POSTGRES_PASSWORD_USER=
POSTGRES_PASSWORD_VENDOR=
POSTGRES_PASSWORD_AUTH=
POSTGRES_PASSWORD_OFFERS=
POSTGRES_PASSWORD_ORDERS=
POSTGRES_PASSWORD_PAYMENTS=
POSTGRES_PASSWORD_NOTIFICATION=

# --- Core secrets ------------------------------------------------------------
# Shared JWT signing secret. Must be identical in every service that validates JWTs.
# Minimum 32 characters (HS256 needs a 256-bit key). Rotating this invalidates all tokens.
JWT_SECRET=

# Shared gateway trust secret, proving to each service that a request came from the gateway.
# Minimum 32 characters. Must be identical in every service.
GATEWAY_INTERNAL_SECRET=

# Redis AUTH password. Redis holds the JWT blacklist, so it must not be unauthenticated.
REDIS_PASSWORD=

# Shared secret for service-to-service internal endpoints (/api/auth/**, /vendors/internal,
# /orders/internal). Must be identical in every service.
INTERNAL_SERVICE_SECRET=

# One-time token for POST /admin/create-initial-admin. Leave EMPTY normally — an empty value
# disables the endpoint. Set it, create the first SUPER_ADMIN, then clear it and restart.
# No admin is seeded into the database, so this is the only way to create the first one.
ADMIN_BOOTSTRAP_TOKEN=

# --- Google OAuth2 (authorization-service) -----------------------------------
# The authorised redirect URI in Google Cloud Console must be
# ${APP_PUBLIC_BASE_URL}/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mailgun (authorization, user, vendor, notification) ---------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Optional: transactional email in notification-service.
NOTIFICATION_EMAIL_ENABLED=true

# --- Google Maps (vendor-service) --------------------------------------------
# Restrict this key by IP and API in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# --- Firebase (notification-service) -----------------------------------------
# Absolute path on the server host to the Firebase Admin SDK JSON. Mounted read-only.
# Keep it outside the repository directory and chmod 600.
FIREBASE_CREDENTIALS_HOST_PATH=/etc/stillfresh/firebase-service-account.json

# --- Payment provider --------------------------------------------------------
# "stripe" or "allsecure".
PAYMENT_PROVIDER=allsecure

# Stripe. Note the previously committed test key is recoverable from git history and
# must be considered burned; issue a fresh key.
STRIPE_API_KEY=

# AllSecure Exchange PRODUCTION credentials. The prod profile has no sandbox fallbacks and
# ProdConfigGuard rejects the paymentsandbox.cloud host and the simulator credentials.
ALLSECURE_BASE_URL=https://asxgw.com
ALLSECURE_API_KEY=
ALLSECURE_SHARED_SECRET=
ALLSECURE_USERNAME=
# Escape a literal $ as $$ when using docker-compose .env interpolation.
ALLSECURE_PASSWORD=
ALLSECURE_INTEGRATION_KEY=
ALLSECURE_CURRENCY=RSD

# --- Platform bank account (bank-transfer payment instructions) --------------
PLATFORM_IBAN=
PLATFORM_BANK_NAME=
PLATFORM_ACCOUNT_HOLDER=
BANK_TRANSFER_EXPIRY_HOURS=24

# --- Vendor payouts ----------------------------------------------------------
# Required, no default: "sepa-xml" or "cmiplus". ProdConfigGuard rejects "stub" while
# PAYOUT_AUTO_EXECUTE is true, because the stub rail marks payouts complete without paying.
PAYOUT_RAIL=cmiplus

PAYOUT_SCHEDULE_CRON=0 0 2 * * *
PAYOUT_DEFAULT_CURRENCY=RSD
PAYOUT_MAX_BATCH_AMOUNT_CENTS=0
PAYOUT_AUTO_ENABLED=true
PAYOUT_AUTO_APPROVE=true
# Keep false until the bank rail has been verified end to end. When false, batches are
# built and approved but no funds leave the platform.
PAYOUT_AUTO_EXECUTE=false

# Directory for generated pain.001 files. These contain vendor IBANs: it must not be
# world-readable, and must not be /tmp.
PAYOUT_SEPA_XML_OUTPUT_DIR=/var/lib/stillfresh/payouts

# --- Raiffeisen CMIplus ------------------------------------------------------
CMIPLUS_ENVIRONMENT=production
CMIPLUS_STUB_MODE=false
CMIPLUS_BASE_URL=
CMIPLUS_CLIENT_ID=
CMIPLUS_CLIENT_SECRET=
CMIPLUS_KEYSTORE_PATH=
CMIPLUS_KEYSTORE_PASSWORD=

# --- Serbian e-fiskalni (optional) -------------------------------------------
FISCAL_ENABLED=false
FISCAL_ENDPOINT_URL=
FISCAL_API_KEY=
