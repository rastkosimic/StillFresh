# Maven target directory
target/
*/target/
**/target/

# Maven local repository
.m2/

# Eclipse IDE files
.classpath
.project
.settings/

# IntelliJ IDEA files
.idea/
*.iml

# Windows specific files
Thumbs.db
ehthumbs.db

# Log files
*.log

# JVM crash dumps (may contain local paths and memory contents)
hs_err_pid*.log
replay_pid*.log

# Temporary files
tmp/
*.tmp
*.swp

# Generated files
*.class
*.jar
*.war
*.ear

# Environment variable files
.env
.env.prod
.env.local
.env.*.local

# Service-account credentials — never commit these
firebase-credentials.json
firebase-credentials.json/
**/*firebase*service-account*.json
**/*-adminsdk-*.json

# Keystores and private keys
*.p12
*.jks
*.pem
*.key

# Generated Postgres init SQL (from db-init/templates via scripts/generate-init-sql.*)
/init-user.sql
/init-vendor.sql
/init-auth.sql
/init-offer.sql
/init-order.sql
/init-payment.sql
/init-notification.sql
/init.sql

# OS-specific files
.DS_Store

# Frontend build artifacts
node_modules/
*.tsbuildinfo
